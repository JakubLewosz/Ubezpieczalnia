# Przykład bez sekretów. Uruchom: python3 scripts/generate_local_config.py
DJANGO_ENV=development
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
POSTGRES_DB=broker_office
POSTGRES_USER=broker
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=54329
REDIS_URL=redis://127.0.0.1:56379/0
# Pusta wartość MEDIA_ROOT oznacza domyślne repo/.local/media.
# MEDIA_ROOT=
OCR_CONCURRENCY=1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
